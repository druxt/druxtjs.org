<?php

/**
 * @file
 * Install and update hooks for the Consumer Node Preview module.
 */

declare(strict_types=1);

use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\Field\FieldStorageDefinitionInterface;
use Drupal\Core\StringTranslation\TranslatableMarkup;

/**
 * Adds the preview layouts field to consumers.
 */
function consumer_node_preview_update_10001(): void {
  // The storage as this update installs it. A later change to the field in
  // hook_entity_base_field_info() needs an update of its own.
  $definition = BaseFieldDefinition::create('string')
    ->setLabel(new TranslatableMarkup('Preview layouts'))
    ->setCardinality(FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED)
    ->setTranslatable(FALSE)
    ->setSetting('max_length', 64);
  \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition('preview_layouts', 'consumer', 'consumer_node_preview', $definition);
}
