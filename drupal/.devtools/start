#!/usr/bin/env php
<?php

/**
 * @file
 * Start the PHP built-in development server.
 *
 * Runs with the working directory set to `web/` (the docroot) — some
 * contrib modules (e.g. jsonapi_hypermedia) resolve paths relative to the
 * process cwd in a way that only matches the docroot under the built-in
 * server, not wherever the shell started.
 *
 * Unlike docs/drupal's `start`, this also writes `BASE_URL` (and, once
 * provisioned, `OAUTH_CLIENT_ID`) to the shared `../.env` — the Nuxt side
 * (`nuxt/nuxt.config.js`) reads both directly from that file, so the
 * developer never hand-copies a URL or client ID between terminals.
 */

declare(strict_types=1);

namespace DocsDevTools;

require_once __DIR__ . '/helpers.php';

// -----------------------------------------------------------------------------
// Variables.
// -----------------------------------------------------------------------------

$webserver = resolve_webserver(auto_discover: TRUE);
$webserver_host = $webserver['host'];
$webserver_port = $webserver['port'];

$webserver_wait_timeout = (int) getenv_default('WEBSERVER_WAIT_TIMEOUT', '20');

// Enable Xdebug when XDEBUG env var is set.
$xdebug_enabled = getenv_default('XDEBUG', '') !== '';
$xdebug_flags = $xdebug_enabled ? ' -d xdebug.mode=debug -d xdebug.start_with_request=yes' : '';

// OPcache and output buffering, as production PHP has them. The CLI server
// only uses OPcache when it is loaded and enabled for the CLI, and it
// revalidates on every request so an edit shows at once.
$opcache_flags = '';
if (extension_loaded('Zend OPcache') || str_contains((string) @shell_exec('php -d zend_extension=opcache -m 2>/dev/null'), 'Zend OPcache')) {
  $opcache_flags = (extension_loaded('Zend OPcache') ? '' : ' -d zend_extension=opcache') . ' -d opcache.enable=1 -d opcache.enable_cli=1 -d opcache.revalidate_freq=0';
}
$performance_flags = ' -d output_buffering=4096' . $opcache_flags;

// -----------------------------------------------------------------------------

echo '===============================' . PHP_EOL;
echo '      💻 START ENVIRONMENT     ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;

if ($xdebug_enabled) {
  TASK('Verifying that the Xdebug PHP extension is installed.');
  $php_v = (string) shell_exec('php -v 2>/dev/null');
  if (stripos($php_v, 'xdebug') === FALSE) {
    FAIL('XDEBUG=1 is set but the Xdebug PHP extension is not installed on the host.');
  }
  PASS('Xdebug extension is loaded.');
}

TASK('Stopping previously started services, if any.');
stop_webserver($webserver_port);

TASK('Starting the PHP webserver (docroot: web/).');
NOTE('Waiting up to %s seconds for the server to be ready.', (string) $webserver_wait_timeout);
// Refuse to start onto a port something else already holds. Without this
// the two checks below both pass against the squatter: fsockopen() finds a
// listener and get_headers() gets a 200, so a failed bind reads exactly
// like a successful start and the caller talks to the wrong site.
//
// stop_webserver() has just run, and a php -S that was killed a moment ago
// can hold its port briefly afterwards, so give the port a few seconds to
// come free before calling it taken. Without the grace period a plain
// restart on the same port fails spuriously, which is a worse bug than the
// one this check exists to catch.
$port_free = FALSE;
for ($i = 0; $i < 3; $i++) {
  $probe = @fsockopen($webserver_host, (int) $webserver_port, $errno, $errstr, 1);
  if ($probe === FALSE) {
    $port_free = TRUE;
    break;
  }
  fclose($probe);
  sleep(1);
}
if (!$port_free) {
  FAIL(
    'Port %s is already in use on %s. Stop whatever holds it, or set WEBSERVER_PORT to a free port.',
    $webserver_port,
    $webserver_host
  );
}

$cwd = (string) getcwd();
// Grouped in a subshell that `exec`s straight into `nohup` (which itself
// execs into `php`, never forking): the backgrounded job ends up as a
// single process whose PID `$!` captures correctly, and which holds no
// inherited copy of this passthru() call's own stdout pipe - without
// this, on some shells the wrapping subshell never exits and passthru()
// blocks forever waiting for a pipe that's still held open, even though
// the actual PHP server started and is serving requests just fine.
passthru(sprintf(
  '(cd %s/web && exec nohup php%s -S %s:%s -t . .ht.router.php </dev/null >/tmp/cms-druxtjs-org-php-server.log 2>&1) & echo $! > %s',
  escapeshellarg($cwd),
  $xdebug_flags . $performance_flags,
  escapeshellarg($webserver_host),
  escapeshellarg($webserver_port),
  escapeshellarg(server_pid_file($webserver_port))
));

$ready = FALSE;
$pid = 0;
for ($i = 0; $i < $webserver_wait_timeout; $i++) {
  sleep(1);
  // Liveness: a cold first start (fresh site, no opcache) can take a
  // while - dots show the script is waiting, not hung.
  echo '.';

  // Watch the process, not just the port. A bind failure kills php -S
  // immediately, and without this the loop would wait out the full timeout
  // before reporting a failure the OS already explained in the log.
  if ($pid === 0) {
    $pid = (int) trim((string) @file_get_contents(server_pid_file($webserver_port)));
  }
  if ($pid > 0 && !@posix_kill($pid, 0)) {
    echo PHP_EOL;
    FAIL("The PHP server exited immediately.\n%s", server_log());
  }

  $fp = @fsockopen($webserver_host, (int) $webserver_port, $errno, $errstr, 1);
  if ($fp !== FALSE) {
    fclose($fp);
    $ready = TRUE;
    break;
  }
}
echo PHP_EOL;
if (!$ready) {
  FAIL("Unable to start inbuilt PHP server.\n%s", server_log());
}
// The port answering is not proof that our server is the one answering.
if ($pid <= 0 || !@posix_kill($pid, 0)) {
  FAIL("The PHP server is not running.\n%s", server_log());
}
PASS('Server started successfully (pid %d).', $pid);

/**
 * The server log, or a note that there isn't one.
 *
 * Returned for FAIL() to take as an argument rather than concatenate into
 * its format string: a PHP error containing a % would otherwise be read as
 * a sprintf placeholder and break the error report itself.
 */
function server_log(): string {
  $log = @file_get_contents('/tmp/cms-druxtjs-org-php-server.log');

  return $log === FALSE || trim($log) === '' ? '(no server log)' : trim($log);
}

TASK('Checking that the server can serve content.');
// Generous timeout: the very first request pays for a cold Drupal
// bootstrap (container build, twig compile) with no opcache.
$context = stream_context_create(['http' => ['method' => 'HEAD', 'timeout' => 15, 'ignore_errors' => TRUE]]);
$headers = @get_headers(sprintf('http://%s:%s', $webserver_host, $webserver_port), FALSE, $context);
if ($headers === FALSE || !isset($headers[0]) || (!str_contains($headers[0], '200') && !str_contains($headers[0], '30'))) {
  FAIL('Server is started, but site cannot be served.');
}
PASS('Server can serve content.');

$site_url = sprintf('http://%s:%s', $webserver_host, $webserver_port);

TASK('Writing BASE_URL to ../.env for the Nuxt frontend.');
dotenv_write_var('BASE_URL', $site_url);
PASS('BASE_URL written.');

// Print a one-time login link — non-fatal if the site isn't provisioned yet
// (first run before `.devtools/provision`), since drush() would otherwise
// abort the script.
$login_exit_code = 0;
$login_link = is_file('vendor/bin/drush') ? trim(drush('uli -l %s --no-browser', $site_url, $login_exit_code)) : '';

echo PHP_EOL;
echo '===============================' . PHP_EOL;
echo '    💻 ENVIRONMENT READY  ✅  ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;
echo 'Directory : ' . $cwd . '/web' . PHP_EOL;
echo 'URL       : ' . $site_url . PHP_EOL;
echo 'XDebug    : ' . ($xdebug_enabled ? 'Enabled' : 'Disabled') . PHP_EOL;
if ($login_exit_code === 0 && $login_link !== '') {
  echo 'Login     : ' . $login_link . PHP_EOL;
}
echo PHP_EOL;
if ($login_exit_code !== 0) {
  echo '> Next steps:' . PHP_EOL;
  echo '  .devtools/provision    # Provision the site (first run / reset)' . PHP_EOL;
  echo PHP_EOL;
}
