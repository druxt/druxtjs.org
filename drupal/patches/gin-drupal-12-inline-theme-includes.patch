+// Inlined from includes/breadcrumb.theme: Drupal 12 reads a theme's procedural hooks from
+// its .theme file and src/Hook only, so an include file is never discovered.
+use Drupal\Core\Cache\CacheableMetadata;
+use Drupal\Core\Entity\ContentEntityInterface;
+use Drupal\Core\Entity\EntityInterface;
+use Drupal\Core\Url;
+use Drupal\node\NodeInterface;
