+declare(strict_types=1);
+
+namespace Drupal\field_group\Attribute;
+
+use Drupal\Component\Plugin\Attribute\Plugin;
+
+/**
+ * Attribute discovery for FieldGroupFormatter plugins.
+ *
+ * Drupal 12 requires an attribute class on every plugin manager; the plugins
+ * themselves still use the FieldGroupFormatter annotation, which core keeps discovering
+ * beside the attribute until Drupal 13.
+ */
+#[\Attribute(\Attribute::TARGET_CLASS)]
+class FieldGroupFormatter extends Plugin {
+}
