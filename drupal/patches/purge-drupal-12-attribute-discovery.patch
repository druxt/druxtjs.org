--- a/src/Attribute/PurgeDiagnosticCheck.php	1970-01-01 00:00:00.000000000 +0000
+++ b/src/Attribute/PurgeDiagnosticCheck.php	2026-10-12 01:01:09.499984010 +0000
@@ -0,0 +1,18 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\purge\Attribute;
+
+use Drupal\Component\Plugin\Attribute\Plugin;
+
+/**
+ * Attribute discovery for PurgeDiagnosticCheck plugins.
+ *
+ * Drupal 12 requires an attribute class on every plugin manager; the plugins
+ * themselves still use the PurgeDiagnosticCheck annotation, which core keeps discovering
+ * beside the attribute until Drupal 13.
+ */
+#[\Attribute(\Attribute::TARGET_CLASS)]
+class PurgeDiagnosticCheck extends Plugin {
+}
