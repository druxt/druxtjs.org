---
extends: default
rules:
  # 200, not 80: pipeline scripts carry long commands, and wrapping them makes
  # them harder to read rather than easier.
  line-length:
    max: 200
    level: warning
  truthy:
    check-keys: false
  # Prettier formats this repository's YAML and writes one space before an
  # inline comment. yamllint wants two, and lint:format is the harder gate.
  comments:
    min-spaces-from-content: 1
